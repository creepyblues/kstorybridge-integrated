# KStoryBridge E2E Test Environment Configuration
# Copy this file to .env.test and fill in actual values

# Test environment (staging | production | localhost)
TEST_ENV=staging

# Test user credentials
# IMPORTANT: Use dedicated test accounts, NOT real user accounts!
TEST_BUYER_EMAIL=test-buyer@example.com
TEST_BUYER_PASSWORD=secure-test-password-123

TEST_CREATOR_EMAIL=test-creator@example.com
TEST_CREATOR_PASSWORD=secure-test-password-123

# Optional: For specific tests requiring existing data
# Replace with actual UUIDs from test database
TEST_TITLE_ID=00000000-0000-0000-0000-000000000000
OTHER_CREATOR_TITLE_ID=00000000-0000-0000-0000-000000000000

# Playwright configuration (optional overrides)
# PLAYWRIGHT_HEADLESS=false
# PLAYWRIGHT_SLOWMO=100
