# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local Development Auto-Login (DO NOT USE IN PRODUCTION)
# These variables should NEVER exist in production environment files
# VITE_DISABLE_AUTH_LOCALHOST=true
# VITE_DEV_ADMIN_EMAIL=your_dev_admin_email
# VITE_DEV_ADMIN_PASSWORD=your_dev_admin_password

# OpenAI Configuration (Optional - script will use fallback method if not provided)
OPENAI_API_KEY=your_openai_api_key