# Google Analytics Configuration
# Replace GA_MEASUREMENT_ID with your actual Google Analytics 4 measurement ID
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=GA_MEASUREMENT_ID

# Local Development Auto-Login (DO NOT USE IN PRODUCTION)
# This allows auto-login as sungho@kstorybridge.com when running on localhost
# This variable should NEVER exist in production environment files
# VITE_DISABLE_AUTH_LOCALHOST=true

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Stripe Configuration for Pro Tier Payments
# Get your keys from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Environment Variables for Supabase Edge Functions
# These should be added to Supabase project secrets via CLI or dashboard
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# STRIPE_PRICE_ID_PRO=price_your_pro_plan_price_id_here