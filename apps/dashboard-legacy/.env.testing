# Testing Environment - Local Backend Mode
# This environment mirrors production behavior locally for accurate testing

# Dashboard URLs
VITE_DASHBOARD_URL=http://localhost:8081
VITE_WEBSITE_URL=http://localhost:5173

# === OPENAI TESTING CONFIGURATION ===
# Enable OpenAI functionality
VITE_OPENAI_ENABLED=true

# Force production-like behavior (uses backend API instead of direct client)
VITE_FORCE_OPENAI_PRODUCTION=true

# Use local backend server for testing
VITE_USE_LOCAL_BACKEND=true
VITE_LOCAL_BACKEND_URL=http://localhost:3001

# === SUPABASE CONFIGURATION ===
# Use production Supabase with local URLs (for data consistency)
# (Local Supabase commented out to use production data)
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=local-key

# === TESTING FLAGS ===
# Enable testing mode features
VITE_LOCAL_TESTING=true
VITE_OAUTH_TESTING=true
VITE_AUTH_DEBUG=true

# Enable detailed logging for debugging
VITE_DEBUG_MODE=true