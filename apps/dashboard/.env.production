# Production environment (custom domains)
VITE_WEBSITE_URL=https://kstorybridge.com
VITE_DASHBOARD_URL=https://dashboard.kstorybridge.com

# OpenAI Configuration - SECURE BACKEND API MODE
# The frontend will use the secure API endpoint instead of direct client
# No VITE_OPENAI_API_KEY needed - using backend API proxy
VITE_OPENAI_ENABLED=true

# Supabase Configuration (for serverless function)
# These are used by the backend API function, not the frontend
# Set these in Vercel dashboard as environment variables (not VITE_ prefixed)