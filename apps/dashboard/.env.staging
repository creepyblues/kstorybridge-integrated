# Staging Environment - Production Backend Mode
# This environment tests against the live production API

# Dashboard URLs
VITE_DASHBOARD_URL=http://localhost:8081
VITE_WEBSITE_URL=http://localhost:5173

# === OPENAI PRODUCTION TESTING ===
# Enable OpenAI functionality
VITE_OPENAI_ENABLED=true

# Force production backend usage (tests against live production API)
VITE_FORCE_OPENAI_PRODUCTION=true

# Do NOT use local backend - use production endpoints
# VITE_USE_LOCAL_BACKEND=false

# === SUPABASE CONFIGURATION ===
# Use production Supabase
# (Production Supabase URLs are used by default when not overridden)

# === TESTING FLAGS ===
# Enable testing mode features
VITE_LOCAL_TESTING=true
VITE_OAUTH_TESTING=true
VITE_AUTH_DEBUG=true

# Enable detailed logging for debugging
VITE_DEBUG_MODE=true