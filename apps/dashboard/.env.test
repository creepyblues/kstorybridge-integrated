# === DASHBOARD URLs ===
VITE_DASHBOARD_URL=http://localhost:8081
VITE_WEBSITE_URL=http://localhost:5173

# === LOCAL SUPABASE CONFIGURATION ===
# Use local Supabase instance (requires `npx supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service role key for test utilities (bypasses RLS)
VITE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# === TEST MODE FLAGS ===
# Enable test mode (activates all test features)
VITE_TEST_MODE=true

# Use local Supabase (not production)
VITE_USE_LOCAL_SUPABASE=true

# Testing flags
VITE_LOCAL_TESTING=true
VITE_OAUTH_TESTING=false
VITE_AUTH_DEBUG=true

# === FEATURE FLAGS FOR TESTING ===
# Skip external service calls during tests
VITE_SKIP_EMAIL_SEND=true
VITE_USE_TEST_STRIPE=true
VITE_MOCK_OPENAI=false

# Auto-login feature (for quick testing)
VITE_AUTO_LOGIN_EMAIL=test-buyer-pro@testcompany.com

# Verbose logging
VITE_DEBUG_MODE=true
VITE_VERBOSE_LOGS=true

# === OPENAI CONFIGURATION ===
# Enable OpenAI chatbot (with test data)
VITE_OPENAI_ENABLED=true

# Use local backend for OpenAI (if running api-server locally)
VITE_USE_LOCAL_BACKEND=false
VITE_LOCAL_BACKEND_URL=http://localhost:3001

# === STRIPE CONFIGURATION ===
# Use Stripe test mode
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_key_here

# === EDGE FUNCTIONS ===
# Local edge functions URL
VITE_SUPABASE_FUNCTIONS_URL=http://127.0.0.1:54321/functions/v1

# === DATABASE RESET ===
# WARNING: Dangerous flag, only use in isolated test environments
# Set to true to reset DB on app start (used in CI/CD only)
VITE_RESET_DB_ON_START=false

# ============================================================
# NOTES FOR DEVELOPERS
# ============================================================
#
# 1. LOCAL SUPABASE MUST BE RUNNING
#    Run: npx supabase start
#    Studio: http://127.0.0.1:54324
#
# 2. SEED DATA
#    Automatically loaded on: npx supabase db reset
#    Manual seed: psql -h 127.0.0.1 -p 54323 -U postgres -d postgres -f supabase/seed.sql
#
# 3. TEST USER CREDENTIALS
#    Basic Buyer: test-buyer-basic@testcompany.com / test-password-123
