    "@tiptap/react": "^3.10.5",
    "@tiptap/starter-kit": "^3.10.5",
    "@types/dompurify": "^3.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "deno": "^2.5.4",
    "dompurify": "^3.3.0",
    "dotenv": "^17.2.1",
    "embla-carousel-react": "^8.3.0",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "mermaid": "^11.12.0",
    "next-themes": "^0.3.0",
    "openai": "^4.104.0",
    "puppeteer": "^24.15.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-pdf": "10.0.1",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.15.4",
    "sonner": "^1.5.0",
    "stripe": "^18.5.0",
    "tailwind-merge": "^2.5.2",
