{
  "name": "@kstorybridge/dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:design-system": "vitest --run src/__tests__/design-system/",
    "test:design-system:watch": "vitest --watch src/__tests__/design-system/",
    "validate:design-system": "npm run test:design-system && npm run lint",
    "detect:legacy": "vitest --run src/__tests__/design-system/legacy-detection.test.tsx",
    "check:featured": "node scripts/check_featured_data.js",
    "check:cache": "node scripts/clear_cache_check.js",
    "test:tier-performance": "node scripts/test_tier_performance.js",
    "test:openai:direct": "cp .env.local .env && npm run dev",
    "test:openai:local": "cp .env.testing .env && npm run dev",
    "test:openai:production": "cp .env.staging .env && npm run dev",
    "test:openai:compare": "npm run dev -- --mode testing",
    "docs:copy": "node scripts/copy-docs.js",
    "docs:watch": "node scripts/copy-docs.js --watch",
    "prebuild": "npm run docs:copy",
    "predev": "npm run docs:copy",
    "test:auth": "node test-auth-flows.js",
    "test:auth:verbose": "node test-auth-flows.js --verbose",
    "test:auth:cleanup": "node test-auth-flows.js --verbose --cleanup",
    "test:db": "node test-database-verification.js",
    "test:edge": "node test-edge-functions.js",
    "test:all": "npm run test:auth && npm run test:db && npm run test:edge",
    "test:local": "cp .env.test .env && npm run dev",
    "test:create-user": "node scripts/create-test-user.js",
    "test:create-buyer": "node scripts/create-test-user.js --type=buyer",
    "test:create-creator": "node scripts/create-test-user.js --type=creator",
    "test:cleanup": "node scripts/cleanup-test-data.js",
    "test:verify": "node scripts/verify-test-setup.js",
    "test:seed": "cd supabase && npx supabase db reset",
    "test:studio": "cd supabase && npx supabase studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:auth": "playwright test auth.spec.ts",
    "test:e2e:chatbot": "playwright test chatbot.spec.ts",
    "test:e2e:creator": "playwright test creator-titles.spec.ts",
    "test:e2e:report": "playwright show-report",
    "test:preview": "node scripts/test-preview-deployment.js",
    "test:metrics": "node scripts/generate-test-metrics.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
