# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dashboard URL Configuration
VITE_DASHBOARD_URL=http://localhost:8081
VITE_WEBSITE_URL=http://localhost:5173

# Slack Notifications for Signup Failures
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
# 1. Go to your Slack workspace settings
# 2. Add an app > Create New App > From scratch
# 3. Add "Incoming Webhooks" feature
# 4. Activate Incoming Webhooks and add to workspace
# 5. Copy the webhook URL
VITE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Enable Slack notifications in development (default: false)
# Set to true to receive notifications during local development
VITE_SLACK_ENABLE_DEV=false

# Google Analytics (optional)
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id

# Environment
NODE_ENV=development